RECALL_API_KEY=your_recall_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
PORT=3000

# Webhook URL for bot status updates (join, leave, etc.)
# This bot uses recallai_streaming for transcripts (via WebSocket),
# so ngrok is OPTIONAL - only needed if you want to receive status updates.
#
# For local development WITHOUT status updates:
#   WEBHOOK_URL=https://example.com/webhook
#
# For local development WITH status updates (requires ngrok):
#   1. Install ngrok: https://ngrok.com/
#   2. Run: ngrok http 3000
#   3. Copy the HTTPS URL (e.g., https://abc123.ngrok.io)
#   4. Set WEBHOOK_URL=https://abc123.ngrok.io/webhook
#
# For production, use your server's public URL:
#   WEBHOOK_URL=https://your-public-domain.com/webhook
WEBHOOK_URL=https://example.com/webhook